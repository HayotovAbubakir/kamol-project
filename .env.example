# Supabase (production uchun majburiy)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Session imzosi (production uchun majburiy, kamida 32 belgi)
# Masalan: openssl rand -base64 48
SESSION_SECRET=your_random_session_secret_at_least_32_chars

# Yangi baza yaratilganda admin paroli (ixtiyoriy; bo'lmasa tasodifiy parol server logida chiqadi)
ADMIN_INITIAL_PASSWORD=

# Cron endpoint himoyasi (ixtiyoriy)
CRON_SECRET=

# Cloudflare Workers/Pages: Dashboard → Settings → Variables → Add variable
# (D1 kerak emas — loyiha Supabase ishlatadi)

# Telegram bot (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
API_BASE=http://localhost:5173
